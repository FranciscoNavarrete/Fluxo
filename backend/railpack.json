{
  "$schema": "https://schema.railpack.com",
  "provider": "dotnet",
  "steps": {
    "install": {
      "commands": [
        { "src": ".", "dest": "." },
        "dotnet restore WebApp/CobrosRecurrentes.WebApp.csproj",
        "dotnet restore MigrationRunner/CobrosRecurrentes.MigrationRunner.csproj",
        "mkdir -p /app/obj"
      ]
    },
    "build": {
      "commands": [
        "dotnet publish WebApp/CobrosRecurrentes.WebApp.csproj -c Release -o /app/out",
        "dotnet publish MigrationRunner/CobrosRecurrentes.MigrationRunner.csproj -c Release -o /app/migrations"
      ]
    }
  },
  "deploy": {
    "base": { "image": "mcr.microsoft.com/dotnet/aspnet:8.0" },
    "inputs": [{ "step": "build" }],
    "startCommand": "dotnet /app/migrations/CobrosRecurrentes.MigrationRunner.dll && dotnet /app/out/CobrosRecurrentes.WebApp.dll"
  }
}
